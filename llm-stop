#!/bin/zsh
# Stops the private LLM server: Open WebUI first, then oMLX. Stopping oMLX
# unloads the model and frees its memory. Start again with:
# the llm-start command in this same folder.
DIR="${0:A:h}"
source "$DIR/load-local-env.zsh"

stop_port() {  # name, port
  local pids n=0
  pids=($(lsof -nP -tiTCP:"$2" -sTCP:LISTEN 2>/dev/null))
  if [ ${#pids} -eq 0 ]; then
    echo "$1 is not running."
    return 0
  fi
  echo "Stopping $1..."
  kill -INT $pids 2>/dev/null
  while lsof -nP -iTCP:"$2" -sTCP:LISTEN >/dev/null 2>&1; do
    n=$((n + 1))
    if [ "$n" -eq 20 ]; then
      echo "$1 is slow to stop; asking again more firmly."
      kill -TERM $pids 2>/dev/null
    fi
    if [ "$n" -ge 40 ]; then
      echo "$1 did not stop (process $pids). Port $2 is still in use."
      return 1
    fi
    sleep 1
  done
  echo "$1 stopped."
}

# Show the offline page at the Tailscale address while the server is down.
# Tailscale's Mac app cannot show a page from a file, so a small program
# (offline-page.py) hands out offline/index.html and Tailscale points at it.
# llm-start ends that program again. It does not come back after a reboot.
TS=/usr/local/bin/tailscale
if [ -x "$TS" ]; then
  if ! lsof -nP -iTCP:"$OFFLINE_PORT" -sTCP:LISTEN >/dev/null 2>&1; then
    nohup /usr/bin/python3 "$DIR/offline-page.py" "$OFFLINE_PORT" \
      "$DIR/offline/index.html" >> "$DIR/offline-page.log" 2>&1 &
    disown
    n=0
    while ! lsof -nP -iTCP:"$OFFLINE_PORT" -sTCP:LISTEN >/dev/null 2>&1; do
      n=$((n + 1))
      [ "$n" -ge 25 ] && break
      sleep 0.2
    done
  fi
  if lsof -nP -iTCP:"$OFFLINE_PORT" -sTCP:LISTEN >/dev/null 2>&1 \
     && "$TS" serve --bg "$OFFLINE_PORT" >/dev/null 2>&1; then
    echo "Offline page is showing at the Tailscale address."
  else
    # Fallback: plain text, which needs no program. The wording is the first
    # line of offline-message.txt in this folder.
    echo "The offline page did not start (see $DIR/offline-page.log). Using the plain message instead."
    msg="$(head -n 1 "$DIR/offline-message.txt" 2>/dev/null)"
    [ -n "$msg" ] || msg="Server not running."
    if "$TS" serve --bg "text:$msg" >/dev/null 2>&1; then
      echo "Offline message is showing at the Tailscale address."
    else
      echo "Could not switch the Tailscale address to the offline message."
    fi
  fi
fi

stop_port "Open WebUI" "$WEBUI_PORT"
stop_port "Relay" "$RELAY_PORT"
stop_port "oMLX" "$OMLX_PORT"
