# Copy this file to local.env and fill in the real values. local.env is not
# in git. It is loaded as shell by llm-start, llm-stop, start-open-webui.sh
# and the status helper. After changing a value, run ./llm-stop and then
# ./llm-start.

# The address guests use, without https:// (Tailscale machine name plus
# tailnet name). Find it with: tailscale status --json | grep DNSName
TAILSCALE_HOST=machine-name.tailnet-name.ts.net

# Port oMLX (the model server) listens on, on this Mac only.
OMLX_PORT=0000

# Port Open WebUI (the chat page) listens on, on this Mac only.
WEBUI_PORT=0000

# Port the offline page (shown while the server is stopped) listens on, on
# this Mac only.
OFFLINE_PORT=0000
