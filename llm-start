#!/bin/zsh
# Starts the private LLM server: oMLX (the model) and then Open WebUI (the
# chat page). The port numbers come from local.env. Both run in the background on this Mac only and keep
# running after this window is closed. Nothing here starts at login or
# restarts by itself. Stop with the llm-stop command in this same folder.
# The folder can be moved: the script works from wherever it is kept.
DIR="${0:A:h}"
cd "$DIR" || exit 1
source "$DIR/load-local-env.zsh"

listening() { lsof -nP -iTCP:"$1" -sTCP:LISTEN >/dev/null 2>&1; }

wait_for() {  # port, seconds
  local n=0
  while ! listening "$1"; do
    n=$((n + 1))
    [ "$n" -ge "$2" ] && return 1
    sleep 1
  done
}

if listening "$OMLX_PORT"; then
  echo "oMLX is already running."
else
  echo "Starting oMLX..."
  nohup /opt/homebrew/bin/omlx serve --model-dir "$HOME/models" \
    --host 127.0.0.1 --port "$OMLX_PORT" \
    --api-key "$(cat ./omlx-api-key)" >> ./omlx.log 2>&1 &
  disown
  wait_for "$OMLX_PORT" 60 || { echo "oMLX did not start. See $DIR/omlx.log"; exit 1; }
  echo "oMLX is up."
fi

# The relay sits between the chat page and oMLX. It records who used which
# model, how many tokens and for how long (never the text), and it is where
# the owner reserves the server (see llm-reserve). A reservation does not
# carry over: the server is always unreserved after a start.
if listening "$RELAY_PORT"; then
  echo "Relay is already running."
else
  echo "Starting the relay..."
  # The last value is where the relay asks the chat page's server whether a
  # click on the badge's switch comes from a signed-in owner.
  nohup /usr/bin/python3 ./relay.py "$RELAY_PORT" "$OMLX_PORT" \
    ./usage.csv "http://127.0.0.1:$WEBUI_PORT/api/v1/auths/" >> ./relay.log 2>&1 &
  disown
  wait_for "$RELAY_PORT" 10 || { echo "The relay did not start. See $DIR/relay.log"; exit 1; }
  echo "Relay is up."
fi

if listening "$WEBUI_PORT"; then
  echo "Open WebUI is already running."
else
  echo "Starting Open WebUI (can take up to a minute)..."
  nohup ./start-open-webui.sh >> ./open-webui.log 2>&1 &
  disown
  wait_for "$WEBUI_PORT" 120 || { echo "Open WebUI did not start. See $DIR/open-webui.log"; exit 1; }
  echo "Open WebUI is up."
fi

# Add the status badge to the chat page (free, in use, reserved). Open WebUI
# empties its page-extras folder at every start, so this comes after it is up.
if [ -d ./open-webui-static ]; then
  cp ./chat-page/loader.js ./open-webui-static/loader.js \
    || echo "Could not add the status badge to the chat page."
  # Remove Open WebUI's name and logos from the page (the owner's choice;
  # allowed by its license at 50 people or fewer). The page text and tab
  # title are handled by branding.js, added to the same loader.js; the logos
  # inside the page are hidden by custom.css; the splash screen and the
  # phone home-screen icons are replaced by a blank image. The tab icon
  # (favicon.*) is kept.
  (
    cat ./chat-page/branding.js >> ./open-webui-static/loader.js &&
    cp ./chat-page/custom.css ./open-webui-static/custom.css &&
    for image in splash.png splash-dark.png logo.png apple-touch-icon.png \
                 web-app-manifest-192x192.png web-app-manifest-512x512.png; do
      cp ./chat-page/blank.png "./open-webui-static/$image" || exit 1
    done
  ) || echo "Could not remove the Open WebUI branding from the chat page."
fi

# Warm-up: oMLX loads a model only when the first request for it arrives
# (6 to 8 s). Send one tiny request now, before the address points back at
# the chat page, so the first person does not wait for that. The model is the
# one new chats start on (Open WebUI's saved ui.default_models, read-only;
# the first if several); nothing is warmed if none is set or oMLX does not
# offer it. Sent straight to oMLX, so it is not in usage.csv. A failure only
# prints a note; the server still starts.
echo "Loading the default model..."
/usr/bin/python3 - "$OMLX_PORT" <<'EOF' || echo "Warm-up skipped; the first message will wait for the model to load."
import http.client, json, sqlite3, sys, time
port = int(sys.argv[1])
try:
    db = sqlite3.connect("file:open-webui-data/webui.db?mode=ro", uri=True)
    row = db.execute("select value from config where key = 'ui.default_models'").fetchone()
    model = (json.loads(row[0]) if row else "").split(",")[0].strip()
except Exception:
    model = ""
if not model:
    sys.exit("No default model is set in Open WebUI.")
headers = {"Authorization": "Bearer " + open("omlx-api-key").read().strip(),
           "Content-Type": "application/json"}
c = http.client.HTTPConnection("127.0.0.1", port, timeout=30)
c.request("GET", "/v1/models", headers=headers)
if model not in [m["id"] for m in json.loads(c.getresponse().read())["data"]]:
    sys.exit("oMLX does not offer the default model %s." % model)
start = time.time()
c = http.client.HTTPConnection("127.0.0.1", port, timeout=180)
c.request("POST", "/v1/chat/completions", headers=headers, body=json.dumps(
    {"model": model, "messages": [{"role": "user", "content": "Reply with OK."}],
     "max_tokens": 1}))
reply = c.getresponse()
reply.read()
if reply.status != 200:
    sys.exit("oMLX answered %d." % reply.status)
print("%s is loaded (%.0f s)." % (model, time.time() - start))
EOF

# Point the Tailscale address back at the chat page (llm-stop switches it to
# the offline page), then end the small program that hands out that page.
# If the switch fails, the offline page is left up so guests do not see a
# bare error.
TS=/usr/local/bin/tailscale
switched=yes
if [ -x "$TS" ]; then
  if ! "$TS" serve --bg "$WEBUI_PORT" >/dev/null 2>&1; then
    switched=no
    echo "Could not point the Tailscale address at the chat page. Run: tailscale serve --bg $WEBUI_PORT"
  fi
fi
# Let the badge reach the relay. Two addresses are passed to it and nothing
# else on the relay is reachable from other devices:
#   /llm-status   the read-only state, for everyone's badge.
#   /llm-reserve  the owner's switch. The relay refuses it unless the request
#                 carries the sign-in of an owner, which it checks itself.
if [ -x "$TS" ]; then
  "$TS" serve --bg --set-path /llm-status "http://127.0.0.1:$RELAY_PORT/relay/status" >/dev/null 2>&1 \
    || echo "Could not make the server's state readable by the status badge."
  "$TS" serve --bg --set-path /llm-reserve "http://127.0.0.1:$RELAY_PORT/relay/owner-reserve" >/dev/null 2>&1 \
    || echo "Could not make the owner's switch on the status badge reachable."
fi
if [ "$switched" = yes ]; then
  offline_pids=($(lsof -nP -tiTCP:"$OFFLINE_PORT" -sTCP:LISTEN 2>/dev/null))
  [ ${#offline_pids} -gt 0 ] && kill -INT $offline_pids 2>/dev/null
fi

echo "Ready: https://$TAILSCALE_HOST (or http://localhost:$WEBUI_PORT at this Mac)"
