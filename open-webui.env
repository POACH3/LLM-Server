# Open WebUI settings for the private LLM server (M0).
# Written 2026-10-10 against Open WebUI 0.11.4. Every name below was checked
# against that version's source, except the three marked "belt and braces".
#
# How it is used: the start script loads this file into the environment and
# then runs Open WebUI. No secrets belong in this file. The oMLX API key is
# read at start time from the omlx-api-key file in this folder.
#
# IMPORTANT: many of these are saved into Open WebUI's database on the FIRST
# start. After that, changing them here has no effect; change them in the
# Admin Panel instead (or delete the data folder to start over).

# --- Where Open WebUI keeps its data (accounts, settings) ---
# DATA_DIR is set by start-open-webui.sh to the open-webui-data folder next
# to it, so this folder can be moved without editing anything.

# --- Nothing leaves this Mac ---
# Blocks the GitHub version check and all Hugging Face downloads.
# Side effect: searching inside uploaded documents is unavailable.
OFFLINE_MODE=true
ENABLE_VERSION_UPDATE_CHECK=false
HF_HUB_OFFLINE=1
# Belt and braces: not read by Open WebUI's own main files, but honored by
# some of the libraries it bundles.
ANONYMIZED_TELEMETRY=false
DO_NOT_TRACK=true
SCARF_NO_ANALYTICS=true
# Features that would contact outside services.
ENABLE_COMMUNITY_SHARING=false
ENABLE_WEB_SEARCH=false
ENABLE_IMAGE_GENERATION=false
ENABLE_DIRECT_CONNECTIONS=false
ENABLE_USER_WEBHOOKS=false

# --- The only model server is oMLX on this Mac ---
ENABLE_OLLAMA_API=false
ENABLE_OPENAI_API=true
# OPENAI_API_BASE_URL is set by start-open-webui.sh from the port in
# local.env. Note: Open WebUI saves the connection address in its database on
# first start, so after changing the port also update it in Admin Panel,
# Settings, Connections.
# OPENAI_API_KEY is supplied by the start script, not stored here.

# --- Conversations: nothing saved for ordinary users (F8, F9) ---
# Admins are exempt from enforced temporary chat: the admin's own chats are
# saved unless a chat is set to temporary.
USER_PERMISSIONS_CHAT_TEMPORARY=true
USER_PERMISSIONS_CHAT_TEMPORARY_ENFORCED=true
# The admin cannot open or export other users' data from the admin screens.
ENABLE_ADMIN_CHAT_ACCESS=false
ENABLE_ADMIN_EXPORT=false
ENABLE_ADMIN_WORKSPACE_CONTENT_ACCESS=false
ENABLE_ADMIN_ANALYTICS=false
# Features that store user content on the server.
ENABLE_MEMORIES=false
USER_PERMISSIONS_FEATURES_MEMORIES=false
ENABLE_NOTES=false
ENABLE_CHANNELS=false
ENABLE_MESSAGE_RATING=false
ENABLE_EVALUATION_ARENA_MODELS=false
USER_PERMISSIONS_CHAT_SHARE=false
# Uploads are ON (owner decision 2026-10-10). Uploaded files are stored on
# the server in DATA_DIR/uploads until deleted.
USER_PERMISSIONS_CHAT_FILE_UPLOAD=true
# No content in logs.
AUDIT_LOG_LEVEL=NONE

# --- No hidden extra requests to the model ---
# Each of these sends a second request per message, which would occupy the
# one-request-at-a-time queue and change what the cache sees.
ENABLE_TITLE_GENERATION=false
ENABLE_TAGS_GENERATION=false
ENABLE_FOLLOW_UP_GENERATION=false
ENABLE_AUTOCOMPLETE_GENERATION=false
ENABLE_SEARCH_QUERY_GENERATION=false
ENABLE_RETRIEVAL_QUERY_GENERATION=false
# Runs code on behalf of users; not needed for the first iteration.
ENABLE_CODE_INTERPRETER=false
ENABLE_CODE_EXECUTION=false

# --- Accounts and logins ---
WEBUI_AUTH=true
# Sign-up is open (owner decision 2026-10-11): guests create their own account,
# which stays "pending" and unusable until the admin approves it. Open WebUI
# turns sign-up off by itself after the first account on a fresh install; it
# was turned back on in the saved settings.
ENABLE_SIGNUP=true
DEFAULT_USER_ROLE=pending
# Passwords need 8+ characters with upper, lower, digit and symbol.
ENABLE_PASSWORD_VALIDATION=true
# Logins expire after 7 days (owner decision 2026-10-11). This value is saved
# in the database on first start; later changes are made in the database or
# Admin Panel, and this line is kept in step for a fresh install.
JWT_EXPIRES_IN=7d
ENABLE_API_KEYS=false
# Only pages served from these addresses may call the API: the Tailscale
# HTTPS address (guests and the owner's other devices) and this Mac itself.
# CORS_ALLOW_ORIGIN is set by start-open-webui.sh from the address and port
# in local.env.

# --- Uploaded documents ---
# The whole text of an uploaded document is placed in the conversation, with
# no search index. This works offline (no embedding model download) and suits
# the goal of reading large documents in full.
BYPASS_EMBEDDING_AND_RETRIEVAL=true

# --- Model access ---
# Every model that oMLX offers is available to every approved user, with no
# per-model registration in Open WebUI. Needed because the admin has no
# special access (ENABLE_ADMIN_WORKSPACE_CONTENT_ACCESS=false above), and it
# lets models be swapped in oMLX without touching Open WebUI.
BYPASS_MODEL_ACCESS_CONTROL=true
